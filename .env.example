# Copy to .env.local and fill in real values. Never commit .env.local.
# Frontend env vars are public config only (SRS v3.0 §11.6). Never add a
# Supabase service-role key, OpenAI key, or HighLevel secret here — those
# live only in the backend's Vercel environment.

# Base URL of the backend API this frontend talks to.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project URL and public anonymous key (safe for browser exposure).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Build/environment label shown in-app (e.g. local, staging, pilot-production).
NEXT_PUBLIC_APP_ENV=local
